---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);

const categories = [
  {
    name: "NixOS",
    tag: "nixos",
    desc: "NixOS 配置、教程与折腾记录",
  },
  {
    name: "项目",
    tag: "project",
    desc: "自己开发的软件与工具",
  },
  {
    name: "旅行",
    tag: "travel",
    desc: "旅行计划与游记",
  },
];

const CATEGORY_LIMIT = 4;
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class:list={["pt-8 pb-6", "border-b border-border"]}>
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Jaanai's Blog
      </h1>
      <a
        target="_blank"
        href="/rss.xml"
        class="inline-block"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>
        Hello, I am Liu Jaanai. Welcome to my Blog.
        This blog is a dedicated space where I document my journey and share my work. Here, you will find my explorations in <strong>open-source software</strong>, practical <strong>tech experiences and tutorials</strong>, and my personal <strong>photography</strong>.
      </p>
    </p>
      <p class="mt-2">
        Read the blog posts or check
        <LinkButton
          class="underline decoration-dashed underline-offset-4 hover:text-accent"
          href="https://github.com/Jaanai-Liu"
        >
          GitHub
        </LinkButton> for more info.
      </p>
      {
        // only display if at least one social link is enabled
        SOCIALS.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">Social Links:</div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      categories.map(({ name, tag, desc }) => {
        const categoryPosts = sortedPosts.filter(({ data }) =>
          data.tags.includes(tag)
        );
        return (
          categoryPosts.length > 0 && (
            <section id={tag} class="pt-12 pb-6 border-b border-border">
              <div class="mb-4 flex items-end justify-between">
                <div>
                  <h2 class="text-2xl font-semibold tracking-wide">{name}</h2>
                  <p class="mt-1 text-sm text-muted-foreground">{desc}</p>
                </div>
                <LinkButton href={`/tags/${tag}/`}>
                  更多
                  <IconArrowRight class="inline-block rtl:-rotate-180" />
                </LinkButton>
              </div>
              <ul>
                {categoryPosts
                  .slice(0, CATEGORY_LIMIT)
                  .map(data => <Card variant="h3" {...data} />)}
              </ul>
            </section>
          )
        );
      })
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        All Posts
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
